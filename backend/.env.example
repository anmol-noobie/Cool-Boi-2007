# Groq API Key (required) - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use (optional, defaults to llama-3.3-70b-versatile)
MODEL_NAME=llama-3.3-70b-versatile

# Allowed frontend origins (comma-separated)
# Replace with your Vercel/Netlify URL after deployment
ALLOWED_ORIGINS=https://coolboi2007.vercel.app
